project           = "db-sharding-aws"
github_repo       = "<OWNER>/<REPO>"
github_owner_id   = "<OWNER_ID>" # gh api repos/<OWNER>/<REPO> --jq .owner.id
github_repo_id    = "<REPO_ID>"  # gh api repos/<OWNER>/<REPO> --jq .id
apply_environment = "db-sharding-aws-apply"
# OIDC プロバイダは terraform/github-oidc が持つ（先にそちらを apply）
create_github_oidc_provider = false
